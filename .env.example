# ==============================================================================
# Stock Prism Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# [REQUIRED] AI Model API Key (Choose ONE of the genuinely free options below)
# ------------------------------------------------------------------------------

# Option A (RECOMMENDED 100% FREE - No credit card required):
# Sign up at: https://console.groq.com/keys
# Supported Models: openai/gpt-oss-120b (default), openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional model override (defaults to openai/gpt-oss-120b):
GROQ_MODEL=openai/gpt-oss-120b

# Option B (ALTERNATIVE 100% FREE - No credit card required):
# Sign up at: https://aistudio.google.com/
# Model: Gemini 2.0 Flash
# GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Option C (PAID / CREDITS REQUIRED):
# If using standard OpenAI or TheSys Generative UI:
# OPENAI_API_KEY=sk-your_openai_api_key_here

# ------------------------------------------------------------------------------
# [OPTIONAL] Custom LLM Provider Overrides (Auto-configured by default)
# ------------------------------------------------------------------------------
# LLM_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# [OPTIONAL] Agent Execution & Reliability Guardrails
# ------------------------------------------------------------------------------
# Maximum graph transitions before halting (default: 20, allows ~9 tool cycles):
AGENT_RECURSION_LIMIT=20
# Maximum seconds for any external yfinance or network request (default: 6.0s):
TOOL_TIMEOUT_SECONDS=6.0

# ------------------------------------------------------------------------------
# [OPTIONAL] Server & Networking Settings
# ------------------------------------------------------------------------------
PORT=8000
LOG_LEVEL=INFO
# Comma-separated allowed frontend origins for CORS (default covers local dev):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# [OPTIONAL] Observability & Tracing (Langfuse)
# If left blank, tracing is safely disabled without errors.
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
